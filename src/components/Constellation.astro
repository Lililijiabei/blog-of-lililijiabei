                0 0 5px rgb(255 255 255 / 0.4),
                0 0 12px oklch(0.62 0.2 318 / 0.25);
        }
    }
    @keyframes cn-label-float {
        0%,
        100% {
            transform: translate3d(0, 0, 0);
        }
