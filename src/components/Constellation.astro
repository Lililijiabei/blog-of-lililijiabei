        box-shadow:
            0 0 8px 3px rgb(255 255 255 / 0.9),
            0 0 22px 10px oklch(0.7 0.26 300 / 0.95),
            0 0 38px 18px oklch(0.62 0.26 300 / 0.6);
    }

    .cn-tip {
        position: absolute;
        top: 50%;
        display: flex;
        flex-direction: column;
        /* 默认：往左（屏幕外侧）展开 */
        right: var(--cn-tip-gap, 33px);
        align-items: flex-end;
        text-align: right;
        gap: 0.15rem;
        /* 宽度按该圆点到屏幕边缘的剩余空间算（JS 写入 --cn-tip-max），超了就换行 */
        max-width: var(--cn-tip-max, 12rem);
        overflow-wrap: break-word;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-50%) scale(0.94);
        transform-origin: right center;
        transition:
            opacity 0.2s ease,
            transform 0.2s ease;
    }
    /* 圆点在线条中心轴的右边 → 气泡往右展开（左边同理） */
    .cn-node[data-tip="right"] .cn-tip {
        right: auto;
        left: var(--cn-tip-gap, 33px);
        align-items: flex-start;
        text-align: left;
        transform-origin: left center;
    }
    .cn-node:hover .cn-tip,
    .cn-node:focus-visible .cn-tip {
        opacity: 1;
        transform: translateY(-50%) scale(1);
    }
    /* 第一行：与首页大昵称同一套渐变字体，字号与下面英文一致 */
    .cn-title {
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1.35;
        white-space: nowrap;
    }
    .cn-meta:empty {
        display: none;
