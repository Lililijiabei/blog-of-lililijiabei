    }
    /* 左侧链条与右侧用同一份渐变：下面实、上面淡 */

    /* 判定范围比视觉上的点大一圈（26px），鼠标在边缘也不会一直进出判定 */
    .cn-node {
        position: absolute;
        display: grid;
        place-items: center;
