    /* 底部两个短语 & 气泡里的英文：同一套字体 + 外发光 */
    .cn-label,
    .cn-en,
    .cn-meta {
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        color: rgb(255 255 255 / 0.88);
        text-shadow:
            0 0 6px rgb(255 255 255 / 0.4),
            0 0 14px oklch(0.62 0.2 318 / 0.3);
        white-space: nowrap;
    }

    /* 线条底部的标注（位置由 JS 按边距中线设置） */
    .cn-label {
        position: absolute;
        /* 原本是 91%，这里整体再下移 1cm */
        top: calc(91% + 1cm);
        pointer-events: none;
        will-change: transform;
    }

    /* 只有底部两个短语带轻微浮动；气泡里的中英文都不浮动 */
    @media (prefers-reduced-motion: no-preference) {
