---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { url } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	/** URL of the newest post. The "recent posts" button is hidden when omitted. */
	latestPostUrl?: string;
	class?: string;
	style?: string;
}

const { latestPostUrl } = Astro.props;
const className = Astro.props.class;
const style = Astro.props.style;

const hero = siteConfig.hero;
const title = hero.title || siteConfig.title;
const subtitle = hero.subtitle || siteConfig.subtitle;
---

{hero.enable && (
<div id="hero" class:list={[className, "card-base relative overflow-hidden mt-[1cm] mb-4 px-6 py-2 md:px-9 md:py-8"]} style={style}>
    <!-- decorative primary-colored glows -->
    <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-2" aria-hidden="true"></div>

    <div class="relative flex flex-col sm:flex-row items-center sm:items-start gap-6 md:gap-9">
        <!-- 头像：原侧栏头像卡已移除，挪进 Hero 卡 -->
        <a aria-label="Go to About Page" href={url('/about/')}
           class="group shrink-0 relative block w-28 h-28 md:w-36 md:h-36 rounded-full overflow-hidden active:scale-95 transition">
            <div class="absolute inset-0 z-50 flex items-center justify-center transition group-hover:bg-black/30">
                <Icon name="fa6-regular:address-card" class="text-white text-3xl transition opacity-0 scale-90 group-hover:opacity-100 group-hover:scale-100"></Icon>
            </div>
            <ImageWrapper src={profileConfig.avatar || ""} alt="Profile Image of the Author" class="w-full h-full"
                          sizes="(max-width: 768px) 96px, 112px" widths={[96, 160, 224]} loading="lazy" fetchpriority="high"></ImageWrapper>
        </a>

        <div class="flex flex-col items-center sm:items-start text-center sm:text-left">
        <div class="hero-accent mb-4" aria-hidden="true"></div>
        <h1 class="text-gradient hero-title text-3xl md:text-5xl font-bold leading-[1.45] mb-5">{title}</h1>
        <p class="text-base md:text-lg text-90">{subtitle}</p>
        {hero.description && <p class="text-sm md:text-base text-75 mt-1.5">{hero.description}</p>}

        <div class="flex flex-wrap gap-3 mt-6 justify-center sm:justify-start">
            <a href={url("/about/")} class="btn-regular rounded-lg h-11 gap-2 px-5 font-bold active:scale-95">
                <Icon name="fa6-regular:address-card" class="text-[1.15rem]"></Icon>
                {i18n(I18nKey.about)}
            </a>
            {latestPostUrl && (
                <a href={latestPostUrl} class="btn-plain border border-[var(--line-color)] rounded-lg h-11 gap-2 px-5 font-bold active:scale-95">
                    {i18n(I18nKey.recentPosts)}
                    <Icon name="fa6-solid:arrow-right" class="text-[0.875rem]"></Icon>
                </a>
            )}
        </div>
        </div>
    </div>
</div>
)}

<style>
    .hero-glow {
        pointer-events: none;
        position: absolute;
        border-radius: 9999px;
        filter: blur(64px);
    }
    .hero-glow-1 {
        width: 16rem;
        height: 16rem;
        top: -5rem;
        right: -4rem;
        background: oklch(0.70 0.24 305);
        opacity: 0.30;
    }
    .hero-glow-2 {
        width: 14rem;
        height: 14rem;
        bottom: -7rem;
        left: -5rem;
        background: var(--primary);
        opacity: 0.12;
    }
    .hero-accent {
        width: 2.5rem;
        height: 3px;
        border-radius: 9999px;
        background: linear-gradient(to right, var(--primary), transparent);
    }

    /* 渐变本体来自全局 .text-gradient / --title-gradient，这里只负责流光动画与尺寸 */
    .hero-title {
        background-size: 220% 100%;
        background-position: 0% 50%;
    }

    @media (prefers-reduced-motion: no-preference) {
        .hero-title {
            animation: hero-shimmer 8s ease-in-out infinite;
        }
        .hero-glow-1 {
            animation: hero-float 9s ease-in-out infinite;
        }
        .hero-glow-2 {
            animation: hero-float 11s ease-in-out infinite reverse;
        }
    }
    @keyframes hero-shimmer {
        0%,
        100% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
    }
    @keyframes hero-float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-1rem);
        }
    }
</style>
