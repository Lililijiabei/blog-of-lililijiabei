---
import Hero from "../components/Hero.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

// 主页不再显示文章列表：文章从左侧链条的圆点直接点进去（老文章走「归档」）
const allBlogPosts = await getSortedPosts();

const latestPost = allBlogPosts[0];
const latestPostUrl = latestPost
	? getPostUrlBySlug(latestPost.slug)
	: undefined;
---

<MainGridLayout>
    <Hero class="onload-animation" style="animation-delay: var(--content-delay)" latestPostUrl={latestPostUrl}></Hero>
</MainGridLayout>
