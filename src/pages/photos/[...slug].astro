---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPhotos } from "../../utils/photo-utils";
import { getDir } from "../../utils/url-utils";
import { resolveRawImagePath } from "../../utils/raw-image-resolver";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const photos = await getSortedPhotos();
	return photos.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;

const imageUrl = entry.data.image
	? resolveRawImagePath(`content/photos/${getDir(entry.id)}${entry.data.image}`)
	: null;

const dateText = formatDateToYYYYMMDD(entry.data.published).replace(/-/g, "·");
---

<MainGridLayout title={entry.data.title} description={entry.data.description} lang={entry.data.lang}>
    <!-- 文本框收缩到只比图片宽一点点，整体居中 -->
    <div class="card-base mx-auto mt-[1cm] w-fit max-w-full">
        <!-- 图片：大小保持不变，依次浮现 -->
        <div class="px-5 pt-5 md:px-6 md:pt-6">
            {imageUrl && (
                <img
                    src={imageUrl}
                    alt={entry.data.title}
                    class="mx-auto block w-[20rem] max-w-full rounded-xl onload-animation"
                    style="animation-delay: 0.05s"
                />
            )}
        </div>

        <!-- 下面两行，居中：日期 + 简短文字 -->
        <div class="px-5 py-4 text-center md:px-6">
            <div class="text-sm text-50 onload-animation" style="animation-delay: 0.15s">
                {dateText}
            </div>
            {entry.data.description && (
                <div class="mt-2 text-75 onload-animation" style="animation-delay: 0.25s">
                    {entry.data.description}
                </div>
            )}
        </div>
    </div>
</MainGridLayout>
