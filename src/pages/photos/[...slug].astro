---
import path from "node:path";
import Markdown from "../../components/misc/Markdown.astro";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPhotos } from "../../utils/photo-utils";
import { getDir } from "../../utils/url-utils";

export async function getStaticPaths() {
	const photos = await getSortedPhotos();
	return photos.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<MainGridLayout title={entry.data.title} description={entry.data.description} lang={entry.data.lang}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
            <div class="relative onload-animation">
                <div class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90">
                    <span class="inline-flex items-center gap-2">
                        {entry.data.title}
                    </span>
                </div>
            </div>

            <div class="onload-animation">
                <PostMetadata
                    class="mb-5"
                    published={entry.data.published}
                    updated={entry.data.updated}
                    tags={entry.data.tags}
                    category={entry.data.category}
                ></PostMetadata>
            </div>

            {entry.data.image &&
                <ImageWrapper src={entry.data.image} basePath={path.join("content/photos/", getDir(entry.id))} class="mb-8 rounded-xl banner-container onload-animation"
                              sizes="(max-width: 768px) 100vw, 800px" widths={[480, 768, 1024, 1280]} loading="eager" fetchpriority="high" raw={true} />
            }

            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
